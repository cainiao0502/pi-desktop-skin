{
  "schemaVersion": 1,
  "id": "local.miku-theme",
  "name": "Miku Theme",
  "version": "1.0.0",
  "description": "初音未来双主题：Cyber Diva（暗 · 深夜蓝 × 霓虹 Teal）与 Snow Miku（亮 · 雪白 × 冰蓝）。低调克制，覆盖全部界面 token。",
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "title": "Miku Theme"
  },
  "contributes": {
    "themes": [
      {
        "id": "cyber-diva",
        "label": "Cyber Diva（初音 · 暗）",
        "path": "themes/cyber-diva.css",
        "base": "dark",
         "assets": ["themes/assets/wallpaper-dark.webp"]
      },
      {
        "id": "snow-miku",
        "label": "Snow Miku（初音 · 亮）",
        "path": "themes/snow-miku.css",
        "base": "light",
         "assets": ["themes/assets/wallpaper-light.webp"]
      }
    ],
    "windowAppearance": {
      "backgroundColor": {
        "dark": "#0a0f16",
        "light": "#f0f7f3"
      }
    },
    "commands": [
      {
        "id": "miku-theme.open",
        "title": "Miku Theme: Open Panel",
        "keywords": ["miku", "theme"]
      }
    ]
  },
  "permissions": [
    "ui.panel",
    "ui.theme",
    "ui.window.appearance"
  ],
  "engines": {
    "piDesktop": ">=0.1.0"
  },
  "activationEvents": [
    "onCommand:miku-theme.open",
    "onStartup"
  ]
}
